                "type": "boolean"
              },
              "force_triple_execute": {
                "description": "Force all three engines to execute after discussion",
                "type": "boolean"
              },
              "risk_level": {
                "description": "Risk level for execution strategy (default: medium)",
                "enum": [
                  "low",
                  "medium",
                  "high"
                ],
                "type": "string"
              },
              "task": {
                "description": "Task description, as detailed as possible",
                "type": "string"
              }
            },
            "required": [
              "task"
            ],
            "type": "object"
          }
        },
        "type": "function"
      },
      {
        "function": {
