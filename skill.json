                "type": "string"
              },
              "topic": {
                "description": "Research topic",
                "type": "string"
              }
            },
            "required": [
              "topic"
            ],
            "type": "object"
          }
        },
        "type": "function"
      },
      {
        "function": {
          "description": "Configurable AI pipeline to optimize code: analyze, optimize, verify using AI",
          "name": "ai_serial_optimize",
          "parameters": {
            "properties": {
              "code": {
                "description": "Code to optimize",
                "type": "string"
              },
              "goals": {
                "description": "Optimization goals",
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              "pipeline": {
                "description": "AI execution order [analyzer, optimizer, verifier]",
                "items": {
                  "enum": [
                    "claude",
                    "openai",
                    "gemini"
                  ],
                  "type": "string"
                },
                "type": "array"
              }
            },
            "required": [
              "code"
            ],
            "type": "object"
          }
        },
        "type": "function"
      },
      {
        "function": {
          "description": "Let OpenAI, Claude, Gemini collaborate on a task: discuss, detect consensus, merge or pick best using AI",
          "name": "ai_smart_collaborate",
          "parameters": {
            "properties": {
              "execute_on_disagreement": {
