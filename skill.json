      {
        "function": {
          "description": "Structured 5-phase pipeline for large-scale code transformations: analyze, decompose, plan, execute, learn. Forces disciplined approach instead of immediate coding.",
          "name": "spec_driven",
          "parameters": {
            "properties": {
              "action": {
                "description": "Pipeline phase to invoke",
                "enum": [
                  "analyze",
                  "decompose",
                  "plan",
                  "execute",
                  "status"
                ],
                "type": "string"
              },
              "analysis_result": {
                "description": "Analysis output (for analyze callback)",
                "type": "object"
              },
              "goal": {
                "description": "Project goal (required for analyze)",
                "type": "string"
              },
              "plan_result": {
                "description": "Plan output (for plan callback)",
                "type": "object"
              },
              "project_id": {
                "description": "Project ID (required for decompose/plan/execute/status)",
                "type": "string"
              },
              "task_error": {
                "description": "Report task failure (for execute)",
                "type": "string"
              },
              "task_id": {
                "description": "Sub-task ID (for execute)",
                "type": "string"
              },
              "task_result": {
                "description": "Submit execution result (for execute)",
                "type": "string"
              },
              "tasks": {
                "description": "Task list (for decompose callback)",
                "type": "array"
              },
              "workspace": {
                "description": "Workspace root path (optional)",
                "type": "string"
              }
            },
            "required": [
              "action"
            ],
            "type": "object"
          }
        },
        "type": "function"
      },
