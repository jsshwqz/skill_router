{
  "api_schema": {
    "tools": [
      {
        "function": {
          "description": "Broadcast a message to all registered Agents on the message bus",
          "name": "agent_broadcast",
          "parameters": {
            "properties": {
              "message": {
                "description": "Message content to broadcast",
                "type": "string"
              }
            },
            "required": [
              "message"
            ],
            "type": "object"
          }
        },
        "type": "function"
      },
      {
        "function": {
          "description": "Delegate a task to a specific Agent by ID via the message bus",
          "name": "agent_delegate",
          "parameters": {
            "properties": {
              "capability": {
                "description": "Capability to invoke on target",
                "type": "string"
              },
              "target_agent_id": {
                "description": "Target Agent ID",
                "type": "string"
              },
              "task": {
                "description": "The task to delegate",
                "type": "string"
              }
            },
            "required": [
              "task",
              "target_agent_id"
            ],
            "type": "object"
          }
        },
        "type": "function"
      },
      {
        "function": {
          "description": "Send a query to multiple Agents and aggregate all responses",
          "name": "agent_gather",
          "parameters": {
            "properties": {
              "agent_ids": {
                "description": "Target Agent IDs",
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              "query": {
                "description": "Query to send to Agents",
                "type": "string"
              },
              "timeout_secs": {
                "default": 10,
                "type": "integer"
              }
            },
            "required": [
              "query"
            ],
            "type": "object"
          }
        },
        "type": "function"
      },
      {
        "function": {
          "description": "Query the status of all registered Agents or a specific Agent",
          "name": "agent_status",
          "parameters": {
            "properties": {
              "agent_id": {
                "description": "Optional specific Agent ID to query",
                "type": "string"
              }
            },
            "type": "object"
          }
        },
        "type": "function"
      },
      {
        "function": {
          "description": "Generate code with one AI engine and review with another using AI",
          "name": "ai_code_generate",
          "parameters": {
            "properties": {
              "language": {
                "description": "Programming language (default: python)",
                "type": "string"
              },
              "primary": {
                "description": "Primary generator",
                "enum": [
                  "claude",
                  "openai",
                  "gemini"
                ],
                "type": "string"
              },
              "reviewer": {
                "description": "Code reviewer",
                "enum": [
                  "claude",
                  "openai",
                  "gemini"
                ],
                "type": "string"
              },
              "task": {
                "description": "Code requirement",
                "type": "string"
              }
            },
            "required": [
              "task"
            ],
            "type": "object"
          }
        },
        "type": "function"
      },
      {
        "function": {
          "description": "Two AI engines cross-review code, merge opinions using AI",
          "name": "ai_cross_review",
          "parameters": {
            "properties": {
              "code": {
                "description": "Code to review",
                "type": "string"
              },
              "engines": {
                "description": "Two engines (default: [claude, openai])",
                "items": {
                  "enum": [
                    "claude",
                    "openai",
                    "gemini"
                  ],
                  "type": "string"
                },
                "type": "array"
              }
            },
            "required": [
              "code"
            ],
            "type": "object"
          }
        },
        "type": "function"
      },
      {
        "function": {
          "description": "Process long content with Gemini's ultra-long context, optionally verify with other AI",
          "name": "ai_long_context",
          "parameters": {
            "properties": {
              "content": {
                "description": "Long text content",
                "type": "string"
              },
              "task": {
                "description": "Processing task",
                "type": "string"
              },
              "verify_with": {
                "description": "Verification engines (optional)",
                "items": {
                  "enum": [
                    "claude",
                    "openai"
                  ],
                  "type": "string"
                },
                "type": "array"
              }
            },
            "required": [
              "content",
              "task"
            ],
            "type": "object"
          }
        },
        "type": "function"
      },
      {
        "function": {
          "description": "Multiple AI engines solve a problem in parallel, compare and pick best using AI",
          "name": "ai_parallel_solve",
          "parameters": {
            "properties": {
              "engines": {
                "description": "Engines to use (default: all)",
                "items": {
                  "enum": [
                    "claude",
                    "openai",
                    "gemini"
                  ],
                  "type": "string"
                },
                "type": "array"
              },
              "force_triple_execute": {
                "description": "Force all three engines to execute after discussion",
                "type": "boolean"
              },
              "problem": {
                "description": "Problem description",
                "type": "string"
              },
              "risk_level": {
                "description": "Risk level for execution strategy (default: medium)",
                "enum": [
                  "low",
                  "medium",
                  "high"
                ],
                "type": "string"
              },
              "task": {
                "description": "Alias of problem for natural language callers",
                "type": "string"
              }
            },
            "required": [
              "problem"
            ],
            "type": "object"
          }
        },
        "type": "function"
      },
      {
        "function": {
          "description": "Three-engine multi-perspective research: Claude theory, OpenAI practice, Gemini trends using AI",
          "name": "ai_research",
          "parameters": {
            "properties": {
              "depth": {
                "description": "Research depth",
                "enum": [
                  "quick",
                  "comprehensive",
                  "deep"
