# Aion Forge — 环境变量配置示例
# 复制此文件为 .env 并根据实际情况填写值
# cp .env.example .env

# ── AI 推理后端 (宿主代理 / OpenAI-compatible / Ollama) ─────────────────────

# 宿主平台代理（默认优先）：AionUI 当前可对话模型的本地 Anthropic-compatible 代理
ANTHROPIC_BASE_URL=http://127.0.0.1:8080/v1
ANTHROPIC_API_KEY=host-proxy
ANTHROPIC_MODEL=deepseek-chat

# Passthrough 模式：true=返回 instruction 指令让宿主 LLM 执行（不直连 AI 后端）
# false=直连配置的 AI 后端（需配置 AI_BASE_URL 或以下任一后端）
# AI_PASSTHROUGH=true

# 禁用特定 AI provider（逗号分隔），例如：AI_PROVIDERS_DISABLED=ollama-local,zhipu-ai
# AI_PROVIDERS_DISABLED=

# OpenAI-compatible 主后端（可选，会在宿主代理不可用时尝试）
# AI_BASE_URL=https://openrouter.ai/api/v1
# AI_API_KEY=sk-or-v1-...
# AI_MODEL=inclusionai/ling-2.6-1t:free

# OpenAI（若使用 OpenAI，取消以下注释）
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o

# Google AI（若使用 Gemini，取消以下注释）
# GOOGLE_AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# GOOGLE_AI_API_KEY=AIza...
# GOOGLE_AI_MODEL=gemini-2.0-flash

# Ollama（本地部署，最后回退）
# AI_BASE_URL=http://localhost:11434/v1
# AI_API_KEY=ollama
# AI_MODEL=qwen2.5:7b

# ── 搜索服务 ────────────────────────────────────────────────────────────────

# SerpAPI Key（用于 web_search / discovery_search 能力）
# 获取地址：https://serpapi.com/
SERPAPI_KEY=

# ── 安全策略 ─────────────────────────────────────────────────────────────────

# AI 安全审查失败时的策略：open（放行）| closed（拒绝，推荐生产环境使用）
AI_SECURITY_FAIL_POLICY=open

# ── 分布式 / 多 Agent（Phase 1+，可选）───────────────────────────────────────

# NATS 服务地址（用于多节点通信，留空则使用进程内消息总线）
# NATS_URL=nats://localhost:4222

# 当前节点角色：orchestrator | planner | executor | specialist | reviewer | memory_keeper
# NODE_ROLE=orchestrator

# 当前节点专属能力（specialist 角色时使用，逗号分隔）
# NODE_CAPABILITIES=text_summarize,text_classify,text_extract

# ── HTTP API Server (aion-server) ──────────────────────────────────────────

# 工作区路径（默认使用当前目录）
# AION_WORKSPACE=/path/to/workspace

# 监听地址和端口
AION_HOST=0.0.0.0
AION_PORT=3000

# ── 日志 ────────────────────────────────────────────────────────────────────

# 日志级别：error | warn | info | debug | trace
RUST_LOG=aion_server=info,aion_router=info,aion_intel=info,aion_memory=info
